# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Node
node_modules/

# ビルド生成物 (build_vsix.py が作る vsix)
dist/
*.vsix

# build_vsix.py がプロジェクト直下から backend/ へコピーして作る複製。
# 原本は services/ models/ icons/ ui/account_dialog.py の側なので、
# 複製を追跡すると同じ変更が2箇所に出て差分が読めなくなる。
# backend/cli.py と backend/gui_helper.py は複製ではなく原本なので追跡する。
vscode-extension/backend/services/
vscode-extension/backend/models/
vscode-extension/backend/icons/
vscode-extension/backend/ui/

# 同じ理由の複製。原本はリポジトリ直下の LICENSE で、vsce が梱包元
# ディレクトリの LICENSE しか見ないため、build_vsix.py がここへ複製する。
vscode-extension/LICENSE

# OS / エディタ
.DS_Store
Thumbs.db
