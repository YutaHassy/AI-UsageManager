# vsix に入れないもの。
#
# ここに書いたものは配布物から落ちます。逆に言うと、書かれていない .js は
# そのまま利用者の手元へ届きます (この拡張はビルド工程を持たないため、
# 展開したものが動いているものです)。
#
# ※ このファイルは vsix の中身から再構成したものです (原本は vsix に
#    含まれていません)。

# 梱包スクリプト自身。配布物ではなく、配布物を作る手順。
build_vsix.py
.vscodeignore

# Python の副産物。backend/ を丸ごとコピーするので、混ざると vsix が太る。
**/__pycache__/**
**/*.pyc
**/*.pyo

# PySide6 製のログイン画面を動かしていたヘルパー。**拡張から起動する経路は
# もうありません** (1.7.0 でログイン画面ごと畳みました)。ファイルは残して
# ありますが、配布物へ入れる理由はありません — 入れると、動かせないのに
# PySide6 を要求するコードが利用者の手元に届きます。
backend/gui_helper.py

# QtWebEngine を import するモジュール。**同梱する理由がありません。**
# 配布物の中にこれを読む相手はもういません (残っているのはコメントだけ)。
# しかも import しただけで QApplication の無いこのプロセスを落としうるので、
# 「PySide6 は要りません」と言いながら同梱しておくのは筋が通りません。
# リポジトリにはデスクトップ版のために残してあります。
#
# **profile_storage.py のほうは残します。** あちらは Qt を import せず、
# 保存されたログイン状態の置き場所を知るためのもので、アカウントを消すときに
# 使います。
backend/services/browser_profile.py

# 開発用
.vscode/**
.vscode-test/**
node_modules/**
.gitignore
.git/**
**/*.map
**/.DS_Store
