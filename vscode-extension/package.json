{
  "name": "ai-usage-manager",
  "displayName": "AI-UsageManager",
  "description": "%extension.description%",
  "version": "1.8.3",
  "publisher": "YutaHassy",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/YutaHassy/AI-UsageManager.git"
  },
  "bugs": {
    "url": "https://github.com/YutaHassy/AI-UsageManager/issues"
  },
  "homepage": "https://github.com/YutaHassy/AI-UsageManager#readme",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "chatgpt",
    "gemini",
    "usage",
    "quota"
  ],
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  },
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:aiUsageManager.usage"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "aiUsageManager.pythonPath"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiUsageManager",
          "title": "%viewsContainer.aiUsageManager.title%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "aiUsageManager": [
        {
          "type": "webview",
          "id": "aiUsageManager.launcher",
          "name": "%view.launcher.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "aiUsageManager.open",
        "title": "%command.open.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.refreshAll",
        "title": "%command.refreshAll.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.addAccount",
        "title": "%command.addAccount.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.editAccount",
        "title": "%command.editAccount.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.deleteAccount",
        "title": "%command.deleteAccount.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.relogin",
        "title": "%command.relogin.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.openSettings",
        "title": "%command.openSettings.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.openConfigFile",
        "title": "%command.openConfigFile.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.showLog",
        "title": "%command.showLog.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.restartBackend",
        "title": "%command.restartBackend.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.selectLanguage",
        "title": "%command.selectLanguage.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.selectSort",
        "title": "%command.selectSort.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.zoomIn",
        "title": "%command.zoomIn.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.zoomOut",
        "title": "%command.zoomOut.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.setProxyPassword",
        "title": "%command.setProxyPassword.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.testProxy",
        "title": "%command.testProxy.title%",
        "category": "AI-UsageManager"
      },
      {
        "command": "aiUsageManager.importProxyFromEnvironment",
        "title": "%command.importProxyFromEnvironment.title%",
        "category": "AI-UsageManager"
      }
    ],
    "keybindings": [
      {
        "command": "aiUsageManager.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'aiUsageManager.usage'"
      },
      {
        "command": "aiUsageManager.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeWebviewPanelId == 'aiUsageManager.usage'"
      },
      {
        "command": "aiUsageManager.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeWebviewPanelId == 'aiUsageManager.usage'"
      },
      {
        "command": "aiUsageManager.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'aiUsageManager.usage'"
      },
      {
        "command": "aiUsageManager.zoomOut",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "when": "activeWebviewPanelId == 'aiUsageManager.usage'"
      },
      {
        "command": "aiUsageManager.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeWebviewPanelId == 'aiUsageManager.usage'"
      }
    ],
    "configuration": {
      "title": "AI-UsageManager",
      "properties": {
        "aiUsageManager.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.pythonPath.description%"
        },
        "aiUsageManager.language": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "en", "ja", "ko", "zh-cn"],
          "enumDescriptions": [
            "%configuration.language.enum.auto%",
            "%configuration.language.enum.en%",
            "%configuration.language.enum.ja%",
            "%configuration.language.enum.ko%",
            "%configuration.language.enum.zh-cn%"
          ],
          "description": "%configuration.language.description%"
        },
        "aiUsageManager.openLocation": {
          "type": "string",
          "default": "beside",
          "enum": ["beside", "active"],
          "enumDescriptions": [
            "%configuration.openLocation.enum.beside%",
            "%configuration.openLocation.enum.active%"
          ],
          "description": "%configuration.openLocation.description%"
        },
        "aiUsageManager.zoomLevel": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 200,
          "description": "%configuration.zoomLevel.description%"
        },
        "aiUsageManager.accountSort": {
          "type": "string",
          "default": "manual",
          "enum": ["manual", "usage", "name", "provider", "added"],
          "enumDescriptions": [
            "%configuration.accountSort.enum.manual%",
            "%configuration.accountSort.enum.usage%",
            "%configuration.accountSort.enum.name%",
            "%configuration.accountSort.enum.provider%",
            "%configuration.accountSort.enum.added%"
          ],
          "description": "%configuration.accountSort.description%"
        },
        "aiUsageManager.autoRefreshMinutes": {
          "type": "number",
          "default": 1,
          "enum": [0, 1, 5, 10, 30, 60],
          "enumDescriptions": [
            "%configuration.autoRefreshMinutes.enum.0%",
            "%configuration.autoRefreshMinutes.enum.1%",
            "%configuration.autoRefreshMinutes.enum.5%",
            "%configuration.autoRefreshMinutes.enum.10%",
            "%configuration.autoRefreshMinutes.enum.30%",
            "%configuration.autoRefreshMinutes.enum.60%"
          ],
          "description": "%configuration.autoRefreshMinutes.description%"
        },
        "aiUsageManager.refreshOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.refreshOnOpen.description%"
        },
        "aiUsageManager.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showStatusBar.description%"
        },
        "aiUsageManager.proxy.mode": {
          "type": "string",
          "default": "system",
          "enum": ["system", "manual", "none"],
          "enumDescriptions": [
            "%configuration.proxy.mode.enum.system%",
            "%configuration.proxy.mode.enum.manual%",
            "%configuration.proxy.mode.enum.none%"
          ],
          "description": "%configuration.proxy.mode.description%"
        },
        "aiUsageManager.proxy.host": {
          "type": "string",
          "default": "",
          "description": "%configuration.proxy.host.description%"
        },
        "aiUsageManager.proxy.port": {
          "type": "number",
          "default": 8080,
          "description": "%configuration.proxy.port.description%"
        },
        "aiUsageManager.proxy.username": {
          "type": "string",
          "default": "",
          "description": "%configuration.proxy.username.description%"
        }
      }
    }
  }
}
